
spawn-at-startup "steam"
spawn-at-startup "vesktop"
spawn-at-startup "gelly"
spawn-at-startup "hyprlock"
spawn-at-startup "swaync"

prefer-no-csd
screenshot-path "~/Obrazy/Screenshots/%Y-%m-%d %H-%M-%S-screenshot.png"

xwayland-satelite {
  path "xwayland-satelite"
}
hotkey-overlay {
    skip-at-startup
}
recent-windows {
   off
}
animations {
      workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }    
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}
input {
  keyboard {
    xkb {
      layout "pl"
    }
  }
  mod-key = "Super"

}

binds {
   Mod+Q repeat=false { close-window; }
   Mod+Return {spawn "kitty";}
   Mod+Delete {quit;}
   Mod+L repeat=false {spawn "hyprlock";}
   Mod+E {spawn "dolphin";}
   Mod+D {spawn "hyprlauncher";}
   Mod+Tab {toggle-window-floating;}
   Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-left; }
   Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-right; }
   Mod+Left {focus-workspace-left;}
   Mod+Right {focus-workspace-right;}
   Mod+Print {screenshot;}
  }
